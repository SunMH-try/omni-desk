# 子系统A服务配置
A_BASE_URL=http://localhost:8010
A_MOCK_MODE=true # 设置为true时使用本地mock数据，不调用真实A端服务

# 飞书应用配置
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_VERIFICATION_TOKEN=your_verification_token
FEISHU_ENCRYPT_KEY=your_encrypt_key

# 服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true

# 任务配置
DEFAULT_TASK_GROUP_ID=your_default_task_group_id
DEFAULT_BITABLE_APP_TOKEN=your_default_bitable_app_token
DEFAULT_BITABLE_TABLE_ID=your_default_bitable_table_id

# Demo配置
DEMO_PROJECT_ID=alpha_report_platform
